{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SkillSuggestion": {
      "description": "A skill Jev rated as a high-confidence fit for the current request.",
      "properties": {
        "fitProbability": {
          "format": "double",
          "type": "number"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "fitProbability",
        "name"
      ],
      "type": "object"
    },
    "SkillSuggestionStatus": {
      "description": "Whether Jev returned strong skill matches, no match, or could not complete the check.",
      "enum": [
        "suggested",
        "noMatch",
        "unavailable"
      ],
      "type": "string"
    }
  },
  "description": "Status of Jev's advisory skill-selection pass for a turn.",
  "properties": {
    "status": {
      "$ref": "#/definitions/SkillSuggestionStatus"
    },
    "suggestions": {
      "items": {
        "$ref": "#/definitions/SkillSuggestion"
      },
      "type": "array"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "status",
    "suggestions",
    "threadId",
    "turnId"
  ],
  "title": "SkillSuggestionNotification",
  "type": "object"
}